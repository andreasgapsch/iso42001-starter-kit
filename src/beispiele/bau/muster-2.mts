const tag = (iso: string) => iso.split('-').reverse().join('.');
export const bedingteAnnahme = (r: Risiko, m: string, termin: string, grund: string) =>
  `Angenommen für den Restwert nach Abschluss von ${m} (Termin ${termin}). Bis dahin trägt die Geschäftsleitung den Wert vor der Behandlung von ${(r.w ?? 0) * (r.a ?? 0)} (mittel, über der Akzeptanzgrenze 4), weil ${grund} (Beschluss vom ${tag(r.restrisikoAkzeptiert!.am)}, N-058). Nach Abschluss bestätigt die AIMS-Verantwortliche den Restwert im Register, sonst entscheidet die Geschäftsleitung neu.`;
for (const r of risiken) {
  const b = BEDINGTE_ANNAHMEN[r.id];
  if (b) r.restrisikoBegruendung = bedingteAnnahme(r, ...b);
}

