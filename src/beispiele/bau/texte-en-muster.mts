const monate = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
const datumEn = (tmj: string) => {
  const [t, mo, j] = tmj.split('.');
  return `${Number(t)} ${monate[Number(mo) - 1]} ${j}`;
};
/** Grund für das Tragen des Werts vor der Behandlung bis zum Termin (BEDINGTE_ANNAHMEN, dritter Wert) */
