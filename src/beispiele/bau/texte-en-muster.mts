const bedingteAnnahmeEn = (r: Risiko, m: string, termin: string) =>
  `Accepted for the residual value after completion of ${m.replace(' und ', ' and ')} (due ${datumEn(termin)}). Until then the executive board carries the value before treatment of ${(r.w ?? 0) * (r.a ?? 0)} (medium, above the acceptance threshold 4) because ${GRUND_EN[r.id]} (decision of ${datumEn(r.restrisikoAkzeptiert!.am.split('-').reverse().join('.'))}, N-058). After completion the AIMS manager confirms the residual value in the register; otherwise the executive board decides again.`;

