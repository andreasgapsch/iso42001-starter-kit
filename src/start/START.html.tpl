.segment input { position: absolute; opacity: 0; width: 1px; height: 1px; }
.segment label { padding: 6px 10px; font-size: 13px; cursor: pointer; color: var(--text-2); }
.segment input:checked + label { background: var(--hover); color: var(--text); font-weight: 500; }
.segment input:focus-visible + label { outline: 2px solid var(--fokus); outline-offset: -2px; }
main { padding: 16px 0 40px; }
.kachel { background: var(--flaeche); border: 1px solid var(--linie); border-radius: 12px; padding: clamp(20px, 4vw, 36px); box-shadow: var(--schatten); }
h1 { font-size: clamp(24px, 4vw, 30px); line-height: 1.2; font-weight: 600; letter-spacing: -0.015em; margin: 0 0 10px; }
h2 { font-size: 17px; font-weight: 600; margin: 0 0 10px; }
p { margin: 0 0 12px; }
.lead { color: var(--text-2); max-width: 62ch; }
.stand { font-size: 13px; color: var(--text-2); }
.haupt { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin: 22px 0 6px; }
