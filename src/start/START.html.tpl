<script>
(function () {
  'use strict';
  var SPEICHER_SPRACHE = 'iso42001-starter-kit.start.sprache';
  var SPEICHER_THEME = 'iso42001-starter-kit.start.theme';
  var SPRACHEN = ['de', 'en'];
  var THEMES = ['dunkel', 'hell', 'system'];
  var wurzel = document.documentElement;
  var texte = null;

  function lesen(schluessel) {
    try {
      return window.localStorage.getItem(schluessel);
    } catch (e) {
      return null;
    }
  }
  function schreiben(schluessel, wert) {
    try {
      window.localStorage.setItem(schluessel, wert);
    } catch (e) {
      /* Speicher nicht verfügbar (zum Beispiel file:// in Safari): Wahl gilt nur für diesen Aufruf. */
    }
  }
  function setzeTheme(theme) {
    if (theme === 'system') wurzel.removeAttribute('data-theme');
    else wurzel.setAttribute('data-theme', theme);
  }
  function browserSprache() {
    var liste = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ''];
    for (var i = 0; i < liste.length; i++) {
      var s = String(liste[i] || '').toLowerCase();
      if (s.indexOf('de') === 0) return 'de';
      if (s.indexOf('en') === 0) return 'en';
    }
    return 'en';
  }

  // Dunkel ist die Voreinstellung (wie im AIMS-Manager); hell und «wie System» sind wählbar
  var theme = lesen(SPEICHER_THEME);
  if (THEMES.indexOf(theme) < 0) theme = 'dunkel';
  setzeTheme(theme);

  function anwenden(sprache) {
    var t = texte[sprache];
    wurzel.setAttribute('lang', sprache);
    document.title = t.seitentitel;
    var el = document.querySelectorAll('[data-t]');
    for (var i = 0; i < el.length; i++) {
      var wert = t[el[i].getAttribute('data-t')];
      if (typeof wert === 'string') el[i].textContent = wert;
    }
    var attr = document.querySelectorAll('[data-t-aria]');
    for (var k = 0; k < attr.length; k++) {
      var a = t[attr[k].getAttribute('data-t-aria')];
      if (typeof a === 'string') attr[k].setAttribute('aria-label', a);
    }
    var knopf = document.getElementById('sprache-' + sprache);
    if (knopf) knopf.checked = true;
  }

  function start() {
    try {
      texte = JSON.parse(document.getElementById('texte').textContent);
    } catch (e) {
      return;
    }
    var sprache = lesen(SPEICHER_SPRACHE);
    if (SPRACHEN.indexOf(sprache) < 0 || !texte[sprache]) sprache = browserSprache();
    anwenden(sprache);
    var themeKnopf = document.getElementById('theme-' + theme);
    if (themeKnopf) themeKnopf.checked = true;
    var sprachKnoepfe = document.querySelectorAll('input[name="sprache"]');
    for (var i = 0; i < sprachKnoepfe.length; i++) {
      sprachKnoepfe[i].addEventListener('change', function (ev) {
        var wert = ev.target.value;
        if (SPRACHEN.indexOf(wert) < 0) return;
        anwenden(wert);
        schreiben(SPEICHER_SPRACHE, wert);
      });
    }
    var themeKnoepfe = document.querySelectorAll('input[name="theme"]');
    for (var j = 0; j < themeKnoepfe.length; j++) {
      themeKnoepfe[j].addEventListener('change', function (ev) {
        var wert = ev.target.value;
        if (THEMES.indexOf(wert) < 0) return;
        setzeTheme(wert);
        schreiben(SPEICHER_THEME, wert);
      });
    }
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
  else start();
})();
</script>
