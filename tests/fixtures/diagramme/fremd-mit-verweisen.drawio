<mxfile host="Test" agent="Fremdes Diagramm mit Verweisen ins Internet">
  <diagram id="fremd" name="Fremd">
    <mxGraphModel math="1" backgroundImage="{&quot;src&quot;:&quot;https://example.org/hintergrund.png&quot;,&quot;width&quot;:100,&quot;height&quot;:100}">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="a" value="&lt;img src=&quot;https://example.org/x.png&quot; onerror=&quot;window.__xss=1&quot;&gt;Label&lt;script&gt;window.__xss=2&lt;/script&gt;" style="html=1;" vertex="1" parent="1">
          <mxGeometry x="10" y="10" width="200" height="40" as="geometry"/>
        </mxCell>
        <UserObject id="b" label="Skript-Link" link="javascript:window.__xss=4">
          <mxCell style="html=1;rounded=1;" vertex="1" parent="1">
            <mxGeometry x="10" y="70" width="120" height="40" as="geometry"/>
          </mxCell>
        </UserObject>
        <UserObject id="c" label="Link ins Internet" link="https://example.org/">
          <mxCell style="html=1;rounded=1;" vertex="1" parent="1">
            <mxGeometry x="150" y="70" width="140" height="40" as="geometry"/>
          </mxCell>
        </UserObject>
        <mxCell id="d" value="" style="shape=image;image=https://example.org/bild.png;" vertex="1" parent="1">
          <mxGeometry x="10" y="130" width="40" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="e" value="Schrift" style="html=1;fontFamily=Roboto;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRoboto;" vertex="1" parent="1">
          <mxGeometry x="70" y="130" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="f" value="" style="shape=mxgraph.unbekannt.irgendwas;" vertex="1" parent="1">
          <mxGeometry x="190" y="130" width="40" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="g" value="&lt;div style=&quot;background:url(https://example.org/y.png)&quot;&gt;CSS&lt;/div&gt;" style="html=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="130" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="h" value="$$x^2$$" style="html=1;" vertex="1" parent="1">
          <mxGeometry x="10" y="190" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="k" style="edgeStyle=orthogonalEdgeStyle;flowAnimation=1;html=1;" edge="1" parent="1" source="b" target="c">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
